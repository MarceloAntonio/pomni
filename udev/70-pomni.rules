# AULA F Series: active local desktop user access.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3554", ATTRS{idProduct}=="fa09", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="258a", ATTRS{idProduct}=="010c", TAG+="uaccess"
# Bluetooth devices are filtered again by model identity in the application.
SUBSYSTEM=="hidraw", KERNELS=="0005:258A:*", TAG+="uaccess"
SUBSYSTEM=="hidraw", KERNELS=="0005:3554:*", TAG+="uaccess"
